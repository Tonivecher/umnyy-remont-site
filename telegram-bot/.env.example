# Основной токен бота от @BotFather (обязательный)
TELEGRAM_TOKEN=PUT_YOUR_TELEGRAM_TOKEN_HERE

# ID администратора (число). Узнать: @userinfobot
ADMIN_ID=123456789

# JSON сервисного аккаунта Google
# Создать: Google Cloud Console → APIs & Services → Credentials → Service Account
# Таблица в Google Sheets должна называться "Leads", первый лист
GOOGLE_CREDENTIALS={"type":"service_account",...}

# Локальная база данных для сессий смет
# По умолчанию используется SQLite локально (data/app.sqlite)
SQLITE_PATH=data/app.sqlite

# Опционально: URL внешней базы данных PostgreSQL (если планируется использовать вместо SQLite)
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname

# Telegram Mini App
# Публичный HTTPS URL мини-приложения (который открывает кнопка в боте)
MINI_APP_URL=http://localhost:8080/miniapp
# Настройки встроенного mini app сервера статики/API
MINI_APP_HOST=0.0.0.0
MINI_APP_PORT=8080
# Включить встроенный mini app HTTP-сервер (1 - включен, 0 - выключен)
ENABLE_MINI_APP_SERVER=1

# Срок жизни Telegram initData в секундах
MINI_APP_AUTH_MAX_AGE_SECONDS=86400

# Транспорт бота: auto / polling / webhook
BOT_TRANSPORT=polling

# Настройки Webhook (нужны только если BOT_TRANSPORT=webhook)
WEBHOOK_PATH=/telegram/webhook
# WEBHOOK_BASE_URL=https://your-bot-domain.com

# Опционально: режим окружения (production / development)
ENV=development

